<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_BelowStackOrder" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_BelowStackOrder" name="Below stack order" isExecutable="true">
    <bpmn:documentation>Rule C fixture: the below-alternates of one gateway stack longest-first, so
the longest alternate sits directly under the spine and the shortest ends up
furthest away.

Shape: Start -&gt; Receive -&gt; Gateway_FiveWaySplit -&gt; Fulfil -&gt; End (happy path),
plus four dead-ending alternates of 4, 3, 2 and 1 tasks. Five outgoing flows
mean nothing is lifted (rule B), so all four alternates compete for the tiers
below the spine.

The alternates are DECLARED shortest-first (one task, then two, then three,
then four). Stacking by declaration order would therefore produce exactly the
inverse of the required order, which makes the fixture discriminating: only
sorting by subtree weight yields the expected tiers.

Exercises:
  - the row index of an alternate increases strictly as its length decreases.</bpmn:documentation>
    <bpmn:startEvent id="Start_Stack" name="Claim filed">
      <bpmn:outgoing>Flow_start_to_receive</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_start_to_receive" sourceRef="Start_Stack" targetRef="Task_ReceiveClaim" />
    <bpmn:serviceTask id="Task_ReceiveClaim" name="Receive claim">
      <bpmn:incoming>Flow_start_to_receive</bpmn:incoming>
      <bpmn:outgoing>Flow_receive_to_split</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_receive_to_split" sourceRef="Task_ReceiveClaim" targetRef="Gateway_FiveWaySplit" />
    <bpmn:exclusiveGateway id="Gateway_FiveWaySplit" name="Claim type?">
      <bpmn:incoming>Flow_receive_to_split</bpmn:incoming>
      <bpmn:outgoing>Flow_stack_happy</bpmn:outgoing>
      <bpmn:outgoing>Flow_stack_one</bpmn:outgoing>
      <bpmn:outgoing>Flow_stack_two</bpmn:outgoing>
      <bpmn:outgoing>Flow_stack_three</bpmn:outgoing>
      <bpmn:outgoing>Flow_stack_four</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_stack_happy" name="standard" sourceRef="Gateway_FiveWaySplit" targetRef="Task_Fulfil" />
    <bpmn:sequenceFlow id="Flow_stack_one" name="trivial" sourceRef="Gateway_FiveWaySplit" targetRef="Task_One1" />
    <bpmn:sequenceFlow id="Flow_stack_two" name="minor" sourceRef="Gateway_FiveWaySplit" targetRef="Task_Two1" />
    <bpmn:sequenceFlow id="Flow_stack_three" name="major" sourceRef="Gateway_FiveWaySplit" targetRef="Task_Three1" />
    <bpmn:sequenceFlow id="Flow_stack_four" name="fraud" sourceRef="Gateway_FiveWaySplit" targetRef="Task_Four1" />
    <bpmn:serviceTask id="Task_Fulfil" name="Fulfil claim">
      <bpmn:incoming>Flow_stack_happy</bpmn:incoming>
      <bpmn:outgoing>Flow_fulfil_to_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_fulfil_to_end" sourceRef="Task_Fulfil" targetRef="End_Fulfilled" />
    <bpmn:endEvent id="End_Fulfilled" name="Claim fulfilled">
      <bpmn:incoming>Flow_fulfil_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_One1" name="Auto settle">
      <bpmn:incoming>Flow_stack_one</bpmn:incoming>
      <bpmn:outgoing>Flow_one1_to_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_one1_to_end" sourceRef="Task_One1" targetRef="End_One" />
    <bpmn:endEvent id="End_One" name="Auto settled">
      <bpmn:incoming>Flow_one1_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_Two1" name="Check policy">
      <bpmn:incoming>Flow_stack_two</bpmn:incoming>
      <bpmn:outgoing>Flow_two1_to_two2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_two1_to_two2" sourceRef="Task_Two1" targetRef="Task_Two2" />
    <bpmn:serviceTask id="Task_Two2" name="Pay out minor">
      <bpmn:incoming>Flow_two1_to_two2</bpmn:incoming>
      <bpmn:outgoing>Flow_two2_to_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_two2_to_end" sourceRef="Task_Two2" targetRef="End_Two" />
    <bpmn:endEvent id="End_Two" name="Minor settled">
      <bpmn:incoming>Flow_two2_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_Three1" name="Assign adjuster">
      <bpmn:incoming>Flow_stack_three</bpmn:incoming>
      <bpmn:outgoing>Flow_three1_to_three2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_three1_to_three2" sourceRef="Task_Three1" targetRef="Task_Three2" />
    <bpmn:serviceTask id="Task_Three2" name="Inspect damage">
      <bpmn:incoming>Flow_three1_to_three2</bpmn:incoming>
      <bpmn:outgoing>Flow_three2_to_three3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_three2_to_three3" sourceRef="Task_Three2" targetRef="Task_Three3" />
    <bpmn:serviceTask id="Task_Three3" name="Pay out major">
      <bpmn:incoming>Flow_three2_to_three3</bpmn:incoming>
      <bpmn:outgoing>Flow_three3_to_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_three3_to_end" sourceRef="Task_Three3" targetRef="End_Three" />
    <bpmn:endEvent id="End_Three" name="Major settled">
      <bpmn:incoming>Flow_three3_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_Four1" name="Open investigation">
      <bpmn:incoming>Flow_stack_four</bpmn:incoming>
      <bpmn:outgoing>Flow_four1_to_four2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_four1_to_four2" sourceRef="Task_Four1" targetRef="Task_Four2" />
    <bpmn:serviceTask id="Task_Four2" name="Interview claimant">
      <bpmn:incoming>Flow_four1_to_four2</bpmn:incoming>
      <bpmn:outgoing>Flow_four2_to_four3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_four2_to_four3" sourceRef="Task_Four2" targetRef="Task_Four3" />
    <bpmn:serviceTask id="Task_Four3" name="Report to authority">
      <bpmn:incoming>Flow_four2_to_four3</bpmn:incoming>
      <bpmn:outgoing>Flow_four3_to_four4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_four3_to_four4" sourceRef="Task_Four3" targetRef="Task_Four4" />
    <bpmn:serviceTask id="Task_Four4" name="Close as fraud">
      <bpmn:incoming>Flow_four3_to_four4</bpmn:incoming>
      <bpmn:outgoing>Flow_four4_to_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_four4_to_end" sourceRef="Task_Four4" targetRef="End_Four" />
    <bpmn:endEvent id="End_Four" name="Fraud closed">
      <bpmn:incoming>Flow_four4_to_end</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_BelowStackOrder">
    <bpmndi:BPMNPlane id="BPMNPlane_BelowStackOrder" bpmnElement="Process_BelowStackOrder" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
