<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_520a" targetNamespace="http://bpmn.io/schema/bpmn" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:process id="Process_PalletPicking" name="520a - Pallet Picking" isExecutable="true">
    <bpmn:startEvent id="Start_OrderReleased" name="Pallet Order Released for Picking">
      <bpmn:outgoing>Flow_start</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_start" sourceRef="Start_OrderReleased" targetRef="Task_CreatePallet" />
    <bpmn:serviceTask id="Task_CreatePallet" name="Create Pick Pallet Repository">
      <bpmn:incoming>Flow_start</bpmn:incoming>
      <bpmn:outgoing>Flow_pallet_coll</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_pallet_coll" sourceRef="Task_CreatePallet" targetRef="Task_CreateCollection" />
    <bpmn:serviceTask id="Task_CreateCollection" name="Create Collection Movement">
      <bpmn:incoming>Flow_pallet_coll</bpmn:incoming>
      <bpmn:outgoing>Flow_coll_pick</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_coll_pick" sourceRef="Task_CreateCollection" targetRef="Task_Pick" />
    <bpmn:userTask id="Task_Pick" name="Pick at Slot">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_coll_pick</bpmn:incoming>
      <bpmn:incoming>Flow_pallet2_pick</bpmn:incoming>
      <bpmn:incoming>Flow_next_stop</bpmn:incoming>
      <bpmn:incoming>Flow_retry_yes</bpmn:incoming>
      <bpmn:incoming>Flow_retarget_pick</bpmn:incoming>
      <bpmn:outgoing>Flow_pick_gw</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_pick_gw" sourceRef="Task_Pick" targetRef="Gw_Stop" />
    <bpmn:exclusiveGateway id="Gw_Stop" name="Stop result?">
      <bpmn:incoming>Flow_pick_gw</bpmn:incoming>
      <bpmn:outgoing>Flow_stop_picked</bpmn:outgoing>
      <bpmn:outgoing>Flow_stop_flag</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_stop_picked" name="picked" sourceRef="Gw_Stop" targetRef="Task_Book" />
    <bpmn:serviceTask id="Task_Book" name="Execute Pick Movement">
      <bpmn:incoming>Flow_stop_picked</bpmn:incoming>
      <bpmn:outgoing>Flow_book_gw</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_book_gw" sourceRef="Task_Book" targetRef="Gw_Pallet" />
    <bpmn:exclusiveGateway id="Gw_Pallet" name="Pallet full or order done?">
      <bpmn:incoming>Flow_book_gw</bpmn:incoming>
      <bpmn:outgoing>Flow_next_stop</bpmn:outgoing>
      <bpmn:outgoing>Flow_pallet_done</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_next_stop" name="next stop" sourceRef="Gw_Pallet" targetRef="Task_Pick" />
    <bpmn:sequenceFlow id="Flow_pallet_done" name="pallet full or done" sourceRef="Gw_Pallet" targetRef="Task_Label" />
    <bpmn:userTask id="Task_Label" name="Print &#38; Apply Pallet Label">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_pallet_done</bpmn:incoming>
      <bpmn:outgoing>Flow_label_gw</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_label_gw" sourceRef="Task_Label" targetRef="Gw_More" />
    <bpmn:exclusiveGateway id="Gw_More" name="More to pick?">
      <bpmn:incoming>Flow_label_gw</bpmn:incoming>
      <bpmn:outgoing>Flow_more_yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_more_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_more_yes" name="yes, new pallet" sourceRef="Gw_More" targetRef="Task_CreatePallet2" />
    <bpmn:serviceTask id="Task_CreatePallet2" name="Create Pick Pallet Repository">
      <bpmn:incoming>Flow_more_yes</bpmn:incoming>
      <bpmn:outgoing>Flow_pallet2_pick</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_pallet2_pick" sourceRef="Task_CreatePallet2" targetRef="Task_Pick" />
    <bpmn:sequenceFlow id="Flow_more_no" name="no" sourceRef="Gw_More" targetRef="Task_Stage" />
    <bpmn:userTask id="Task_Stage" name="Confirm Pallets Staged">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_more_no</bpmn:incoming>
      <bpmn:outgoing>Flow_stage_mark</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_stage_mark" sourceRef="Task_Stage" targetRef="Task_MarkPicked" />
    <bpmn:serviceTask id="Task_MarkPicked" name="Mark Order Picked">
      <bpmn:incoming>Flow_stage_mark</bpmn:incoming>
      <bpmn:outgoing>Flow_mark_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_mark_end" sourceRef="Task_MarkPicked" targetRef="End_Picked" />
    <bpmn:endEvent id="End_Picked" name="Order Picked">
      <bpmn:incoming>Flow_mark_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_stop_flag" name="flagged" sourceRef="Gw_Stop" targetRef="Task_FindAlt" />
    <bpmn:serviceTask id="Task_FindAlt" name="Find Item Elsewhere in Pick Face">
      <bpmn:incoming>Flow_stop_flag</bpmn:incoming>
      <bpmn:outgoing>Flow_alt_gw</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_alt_gw" sourceRef="Task_FindAlt" targetRef="Gw_Alt" />
    <bpmn:exclusiveGateway id="Gw_Alt" name="Item elsewhere in pick face?">
      <bpmn:incoming>Flow_alt_gw</bpmn:incoming>
      <bpmn:outgoing>Flow_alt_yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_alt_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_alt_yes" name="yes, retarget stop" sourceRef="Gw_Alt" targetRef="Task_Retarget" />
    <bpmn:serviceTask id="Task_Retarget" name="Retarget Stop to New Slot">
      <bpmn:incoming>Flow_alt_yes</bpmn:incoming>
      <bpmn:outgoing>Flow_retarget_pick</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_retarget_pick" sourceRef="Task_Retarget" targetRef="Task_Pick" />
    <bpmn:sequenceFlow id="Flow_alt_no" name="no, urgent refill" sourceRef="Gw_Alt" targetRef="Task_ReportFlag" />
    <bpmn:serviceTask id="Task_ReportFlag" name="Report Flag &#38; Request Urgent Refill">
      <bpmn:incoming>Flow_alt_no</bpmn:incoming>
      <bpmn:outgoing>Flow_flag_gw</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_flag_gw" sourceRef="Task_ReportFlag" targetRef="Gw_Retry" />
    <bpmn:exclusiveGateway id="Gw_Retry" name="More stops to try?">
      <bpmn:incoming>Flow_flag_gw</bpmn:incoming>
      <bpmn:outgoing>Flow_retry_yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_retry_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_retry_yes" name="yes" sourceRef="Gw_Retry" targetRef="Task_Pick" />
    <bpmn:sequenceFlow id="Flow_retry_no" name="no, finish short" sourceRef="Gw_Retry" targetRef="Task_LabelShort" />
    <bpmn:userTask id="Task_LabelShort" name="Print &#38; Apply Pallet Label">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_retry_no</bpmn:incoming>
      <bpmn:outgoing>Flow_labels_stage</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_labels_stage" sourceRef="Task_LabelShort" targetRef="Task_StageShort" />
    <bpmn:userTask id="Task_StageShort" name="Confirm Pallets Staged">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_labels_stage</bpmn:incoming>
      <bpmn:outgoing>Flow_stages_record</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_stages_record" sourceRef="Task_StageShort" targetRef="Task_RecordShort" />
    <bpmn:serviceTask id="Task_RecordShort" name="Record Short Pick on Order">
      <bpmn:incoming>Flow_stages_record</bpmn:incoming>
      <bpmn:outgoing>Flow_record_notify</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_record_notify" sourceRef="Task_RecordShort" targetRef="Task_NotifyShort" />
    <bpmn:serviceTask id="Task_NotifyShort" name="Notify Office of Short Pick">
      <bpmn:incoming>Flow_record_notify</bpmn:incoming>
      <bpmn:outgoing>Flow_notify_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_notify_end" sourceRef="Task_NotifyShort" targetRef="End_Short" />
    <bpmn:endEvent id="End_Short" name="Picked Short: Reported">
      <bpmn:incoming>Flow_notify_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:textAnnotation id="Anno_Pick">
      <bpmn:text>ID: PickAtSlot</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Pick" associationDirection="None" sourceRef="Task_Pick" targetRef="Anno_Pick" />
    <bpmn:textAnnotation id="Anno_Label">
      <bpmn:text>ID: PrintAndApplyPalletLabel</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Label" associationDirection="None" sourceRef="Task_Label" targetRef="Anno_Label" />
    <bpmn:textAnnotation id="Anno_Stage">
      <bpmn:text>ID: ConfirmPalletsStaged</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Stage" associationDirection="None" sourceRef="Task_Stage" targetRef="Anno_Stage" />
    <bpmn:textAnnotation id="Anno_LabelShort">
      <bpmn:text>ID: PrintAndApplyPalletLabel</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_LabelShort" associationDirection="None" sourceRef="Task_LabelShort" targetRef="Anno_LabelShort" />
    <bpmn:textAnnotation id="Anno_StageShort">
      <bpmn:text>ID: ConfirmPalletsStaged</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_StageShort" associationDirection="None" sourceRef="Task_StageShort" targetRef="Anno_StageShort" />
  </bpmn:process>
