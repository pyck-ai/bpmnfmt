          <dc:Bounds x="850" y="382" width="82" height="15" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CancelParcel_di" bpmnElement="Task_CancelParcel">
        <dc:Bounds x="521" y="447" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Cancelled_di" bpmnElement="End_Cancelled">
