        <bpmndi:BPMNLabel>
          <dc:Bounds x="365" y="50" width="79" height="15" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Review_di" bpmnElement="Task_Review">
        <dc:Bounds x="515" y="187" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Consolidate_di" bpmnElement="Task_Consolidate">
        <dc:Bounds x="675" y="57" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Routed_di" bpmnElement="End_Routed">
        <dc:Bounds x="867" y="79" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="844" y="122" width="82" height="15" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_start_to_prepare_di" bpmnElement="Flow_start_to_prepare">
        <di:waypoint x="103" y="97" />
        <di:waypoint x="195" y="97" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_prepare_to_route_di" bpmnElement="Flow_prepare_to_route">
        <di:waypoint x="295" y="97" />
        <di:waypoint x="380" y="97" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_route_direct_di" bpmnElement="Flow_route_direct">
        <di:waypoint x="430" y="97" />
        <di:waypoint x="675" y="97" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="438" y="77" width="13" height="15" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_route_review_di" bpmnElement="Flow_route_review">
        <di:waypoint x="405" y="122" />
        <di:waypoint x="405" y="227" />
        <di:waypoint x="515" y="227" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="413" y="127" width="19" height="15" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_review_to_consolidate_di" bpmnElement="Flow_review_to_consolidate">
        <di:waypoint x="615" y="227" />
        <di:waypoint x="725" y="227" />
        <di:waypoint x="725" y="137" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_consolidate_to_end_di" bpmnElement="Flow_consolidate_to_end">
        <di:waypoint x="775" y="97" />
        <di:waypoint x="867" y="97" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
