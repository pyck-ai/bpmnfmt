        <di:waypoint x="712" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_g2_b_di" bpmnElement="Flow_g2_b">
        <di:waypoint x="410" y="245" />
        <di:waypoint x="410" y="480" />
        <di:waypoint x="520" y="480" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="418" y="250" width="43" height="15" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
