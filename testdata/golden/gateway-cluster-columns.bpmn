          <dc:Bounds x="688" y="245" width="83" height="15" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_A_di" bpmnElement="Task_A">
        <dc:Bounds x="520" y="310" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_A_di" bpmnElement="End_A">
        <dc:Bounds x="712" y="332" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="694" y="375" width="71" height="15" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_B_di" bpmnElement="Task_B">
        <dc:Bounds x="520" y="440" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_B_di" bpmnElement="End_B">
        <dc:Bounds x="712" y="462" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="706" y="505" width="47" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_C_di" bpmnElement="Task_C">
        <dc:Bounds x="520" y="50" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_C_di" bpmnElement="End_C">
        <dc:Bounds x="712" y="72" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="690" y="115" width="79" height="15" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_start_g1_di" bpmnElement="Flow_start_g1">
