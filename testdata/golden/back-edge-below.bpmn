<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_BackEdgeBelow" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_BackEdgeBelow" name="Back edge below" isExecutable="true">
    <bpmn:documentation>Rule L3/N3 fixture: the rework branch is a single node across a TWO-column
loop, so L3's exact-fill condition rejects the retrograde walk — and the
branch is a pure loop-return (its only exit loops back to Enter data, an
earlier spine node), so rule N3 lifts it above the spine instead of hanging
it below, returning through the sky into the target's top.

Shape: Start -&gt; Enter data -&gt; Validate -&gt; Gateway_Valid -&gt; Store -&gt; End (happy
path). The "invalid" branch is the single rework task whose only outgoing
flow loops back to Enter data.

Exercises:
  - nothing is laid out retrograde (the fill condition held),
  - the rework task sits above the spine row,
  - the return leaves the task's bottom, runs between the rows and sinks
    into the target's top edge.</bpmn:documentation>
    <bpmn:startEvent id="Start_Rework" name="Form opened">
      <bpmn:outgoing>Flow_start_to_enter</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_start_to_enter" sourceRef="Start_Rework" targetRef="Task_EnterData" />
    <bpmn:userTask id="Task_EnterData" name="Enter data">
      <bpmn:incoming>Flow_start_to_enter</bpmn:incoming>
      <bpmn:incoming>Flow_correct_back</bpmn:incoming>
      <bpmn:outgoing>Flow_enter_to_validate</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_enter_to_validate" sourceRef="Task_EnterData" targetRef="Task_Validate" />
    <bpmn:serviceTask id="Task_Validate" name="Validate data">
      <bpmn:incoming>Flow_enter_to_validate</bpmn:incoming>
      <bpmn:outgoing>Flow_validate_to_gateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_validate_to_gateway" sourceRef="Task_Validate" targetRef="Gateway_Valid" />
    <bpmn:exclusiveGateway id="Gateway_Valid" name="Valid?">
      <bpmn:incoming>Flow_validate_to_gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_valid_yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_valid_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_valid_yes" name="yes" sourceRef="Gateway_Valid" targetRef="Task_Store" />
    <bpmn:sequenceFlow id="Flow_valid_no" name="no" sourceRef="Gateway_Valid" targetRef="Task_Correct" />
    <bpmn:serviceTask id="Task_Store" name="Store record">
      <bpmn:incoming>Flow_valid_yes</bpmn:incoming>
      <bpmn:outgoing>Flow_store_to_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_store_to_end" sourceRef="Task_Store" targetRef="End_Stored" />
    <bpmn:endEvent id="End_Stored" name="Record stored">
      <bpmn:incoming>Flow_store_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_Correct" name="Correct data">
      <bpmn:incoming>Flow_valid_no</bpmn:incoming>
      <bpmn:outgoing>Flow_correct_back</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_correct_back" sourceRef="Task_Correct" targetRef="Task_EnterData" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_BackEdgeBelow">
      <bpmndi:BPMNShape id="Start_Rework_di" bpmnElement="Start_Rework">
        <dc:Bounds x="68" y="202" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="50" y="245" width="71" height="15" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_EnterData_di" bpmnElement="Task_EnterData">
        <dc:Bounds x="196" y="180" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Validate_di" bpmnElement="Task_Validate">
        <dc:Bounds x="356" y="180" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Valid_di" bpmnElement="Gateway_Valid" isMarkerVisible="true">
        <dc:Bounds x="541" y="195" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="549" y="252" width="33" height="15" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Store_di" bpmnElement="Task_Store">
        <dc:Bounds x="676" y="180" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Stored_di" bpmnElement="End_Stored">
        <dc:Bounds x="868" y="202" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="848" y="245" width="75" height="15" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Correct_di" bpmnElement="Task_Correct">
        <dc:Bounds x="356" y="50" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_start_to_enter_di" bpmnElement="Flow_start_to_enter">
        <di:waypoint x="104" y="220" />
        <di:waypoint x="196" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_enter_to_validate_di" bpmnElement="Flow_enter_to_validate">
        <di:waypoint x="296" y="220" />
        <di:waypoint x="356" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_validate_to_gateway_di" bpmnElement="Flow_validate_to_gateway">
        <di:waypoint x="456" y="220" />
        <di:waypoint x="541" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_valid_yes_di" bpmnElement="Flow_valid_yes">
        <di:waypoint x="591" y="220" />
        <di:waypoint x="676" y="220" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="599" y="200" width="19" height="15" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_valid_no_di" bpmnElement="Flow_valid_no">
        <di:waypoint x="566" y="195" />
        <di:waypoint x="566" y="90" />
        <di:waypoint x="456" y="90" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="574" y="175" width="13" height="15" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_store_to_end_di" bpmnElement="Flow_store_to_end">
        <di:waypoint x="776" y="220" />
        <di:waypoint x="868" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_correct_back_di" bpmnElement="Flow_correct_back">
        <di:waypoint x="356" y="90" />
        <di:waypoint x="246" y="90" />
        <di:waypoint x="246" y="180" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
