<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_RejoinRiserDepth" targetNamespace="http://bpmn.io/schema/bpmn" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:process id="Process_RejoinRiserDepth" name="Rejoin riser depth" isExecutable="true">
    <bpmn:documentation>Rule N1b fixture: when several rejoins from different rows enter one
target's bottom face, they MERGE onto a single riser standing in the
target's own column instead of stepping apart into neighbouring slots.

Shape: Start -&gt; Prepare -&gt; G_Split -&gt; Main -&gt; G_Join -&gt; End on the
spine, with two alternates rejoining G_Join from two different tiers.

Both tails are activities with a single forward flow, so rule L1 de-aligns
both and both rejoin right-then-up, and neither one's column is blocked by
a shape. The deeper tier's run reaches furthest down, so it owns the riser
and the shallower tier's run is contained in it: what the reader sees is
one line growing as the second arc joins it, ending in one arrowhead on
G_Join's bottom vertex.

Rule M4 ranks a rejoin's riser by the depth of its source row, which keeps
a deeper riser off the horizontal approach of every shallower one. Members
of one merged bundle share a single line, so there is no approach left to
cut and the rank is suppressed; riser-depth-blocked.bpmn covers the case
where the rank still applies.

Exercises:
  - both rejoins turn up in the same column, G_Join's own,
  - both end on the identical point on G_Join's bottom vertex,
  - the shallower run lies inside the deeper one's,
  - the diagram has no crossings.</bpmn:documentation>
    <bpmn:startEvent id="Start_Riser" name="Request filed">
      <bpmn:outgoing>Flow_start_prepare</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_start_prepare" sourceRef="Start_Riser" targetRef="Task_Prepare" />
    <bpmn:serviceTask id="Task_Prepare" name="Prepare request">
      <bpmn:incoming>Flow_start_prepare</bpmn:incoming>
      <bpmn:outgoing>Flow_prepare_split</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_prepare_split" sourceRef="Task_Prepare" targetRef="G_Split" />
    <bpmn:exclusiveGateway id="G_Split" name="Which lane?">
      <bpmn:incoming>Flow_prepare_split</bpmn:incoming>
      <bpmn:outgoing>Flow_split_main</bpmn:outgoing>
      <bpmn:outgoing>Flow_split_near</bpmn:outgoing>
      <bpmn:outgoing>Flow_split_far</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_split_main" name="standard" sourceRef="G_Split" targetRef="Task_Main" />
    <bpmn:serviceTask id="Task_Main" name="Process request">
      <bpmn:incoming>Flow_split_main</bpmn:incoming>
      <bpmn:outgoing>Flow_main_join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_main_join" sourceRef="Task_Main" targetRef="G_Join" />
    <bpmn:exclusiveGateway id="G_Join" name="Handled">
      <bpmn:incoming>Flow_main_join</bpmn:incoming>
      <bpmn:incoming>Flow_near_join</bpmn:incoming>
      <bpmn:incoming>Flow_far2_join</bpmn:incoming>
      <bpmn:outgoing>Flow_join_end</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_join_end" sourceRef="G_Join" targetRef="End_Riser" />
    <bpmn:endEvent id="End_Riser" name="Request handled">
      <bpmn:incoming>Flow_join_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_split_near" name="quick" sourceRef="G_Split" targetRef="Task_Near" />
    <bpmn:serviceTask id="Task_Near" name="Quick check">
      <bpmn:incoming>Flow_split_near</bpmn:incoming>
      <bpmn:outgoing>Flow_near_join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_near_join" sourceRef="Task_Near" targetRef="G_Join" />
    <bpmn:sequenceFlow id="Flow_split_far" name="full" sourceRef="G_Split" targetRef="Task_Far1" />
    <bpmn:serviceTask id="Task_Far1" name="Collect evidence">
      <bpmn:incoming>Flow_split_far</bpmn:incoming>
      <bpmn:outgoing>Flow_far1_far2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_far1_far2" sourceRef="Task_Far1" targetRef="Task_Far2" />
    <bpmn:serviceTask id="Task_Far2" name="Full review">
      <bpmn:incoming>Flow_far1_far2</bpmn:incoming>
      <bpmn:outgoing>Flow_far2_join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_far2_join" sourceRef="Task_Far2" targetRef="G_Join" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_RejoinRiserDepth">
      <bpmndi:BPMNShape id="Start_Riser_di" bpmnElement="Start_Riser">
        <dc:Bounds x="67" y="79" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="50" y="122" width="70" height="15" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Prepare_di" bpmnElement="Task_Prepare">
        <dc:Bounds x="195" y="57" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_Split_di" bpmnElement="G_Split" isMarkerVisible="true">
        <dc:Bounds x="380" y="72" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="372" y="50" width="66" height="15" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Main_di" bpmnElement="Task_Main">
        <dc:Bounds x="515" y="57" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_Join_di" bpmnElement="G_Join" isMarkerVisible="true">
        <dc:Bounds x="860" y="72" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="863" y="50" width="45" height="15" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Riser_di" bpmnElement="End_Riser">
        <dc:Bounds x="1027" y="79" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1023" y="122" width="45" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Near_di" bpmnElement="Task_Near">
        <dc:Bounds x="675" y="317" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Far1_di" bpmnElement="Task_Far1">
        <dc:Bounds x="515" y="187" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Far2_di" bpmnElement="Task_Far2">
        <dc:Bounds x="675" y="187" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_start_prepare_di" bpmnElement="Flow_start_prepare">
        <di:waypoint x="103" y="97" />
        <di:waypoint x="195" y="97" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_prepare_split_di" bpmnElement="Flow_prepare_split">
        <di:waypoint x="295" y="97" />
        <di:waypoint x="380" y="97" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_split_main_di" bpmnElement="Flow_split_main">
        <di:waypoint x="430" y="97" />
        <di:waypoint x="515" y="97" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="438" y="77" width="47" height="15" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_main_join_di" bpmnElement="Flow_main_join">
        <di:waypoint x="615" y="97" />
        <di:waypoint x="860" y="97" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_join_end_di" bpmnElement="Flow_join_end">
        <di:waypoint x="910" y="97" />
        <di:waypoint x="1027" y="97" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_split_near_di" bpmnElement="Flow_split_near">
        <di:waypoint x="405" y="122" />
        <di:waypoint x="405" y="357" />
        <di:waypoint x="675" y="357" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="413" y="127" width="28" height="15" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_near_join_di" bpmnElement="Flow_near_join">
        <di:waypoint x="775" y="357" />
        <di:waypoint x="885" y="357" />
        <di:waypoint x="885" y="122" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_split_far_di" bpmnElement="Flow_split_far">
        <di:waypoint x="405" y="122" />
        <di:waypoint x="405" y="227" />
        <di:waypoint x="515" y="227" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="413" y="155" width="15" height="15" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_far1_far2_di" bpmnElement="Flow_far1_far2">
        <di:waypoint x="615" y="227" />
        <di:waypoint x="675" y="227" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_far2_join_di" bpmnElement="Flow_far2_join">
        <di:waypoint x="775" y="227" />
        <di:waypoint x="885" y="227" />
        <di:waypoint x="885" y="122" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
