<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_RiserDepthBlocked" targetNamespace="http://bpmn.io/schema/bpmn" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:process id="Process_RiserDepthBlocked" name="Riser depth blocked" isExecutable="true">
    <bpmn:documentation>Rule M4 fixture: the depth rank still applies to rejoins that CANNOT
merge onto one riser.

Shape: Start -&gt; G_A -&gt; Assess -&gt; G_B -&gt; Settle -&gt; End on the spine. Two
alternates rejoin Settle from two different tiers, and a third branch off
G_A dead ends in an end event that lands in Settle's OWN column, on the
tier between them.

That dead end is the blocker. Rule N1b lets rejoins arriving at one face
share a single riser in the target's column, but only while that column is
clear of shapes for the rejoin's whole depth. It is clear for the shallow
tier, which turns up above the blocker, and blocked for the deep tier,
whose riser would have to pass straight through it — so no bundle forms
and each rejoin keeps its own riser and its own arrowhead.

The deep tier therefore has to step aside, and it has to step RIGHT: it
approaches Settle from the left along its own row, so a riser turning up
left of the shallow tier's would cut the shallow tier's approach. Rule M4
ranks it one slot deeper than the shallow tier, and that rank is exactly
what gives it the extra slot it needs to clear the blocker — at rank 0 the
offsets it may try all end inside the blocker's clearance.

Exercises:
  - the shallow rejoin turns up in Settle's own column,
  - the deep rejoin turns up strictly right of it, clear of the blocker,
  - both are 3-point right-then-up elbows landing on Settle's bottom face,
  - neither is declared merged into the other,
  - the diagram has no crossings.</bpmn:documentation>
    <bpmn:startEvent id="Start_Blocked" name="Job filed">
      <bpmn:outgoing>Flow_start_a</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_start_a" sourceRef="Start_Blocked" targetRef="G_A" />
    <bpmn:exclusiveGateway id="G_A" name="Route">
      <bpmn:incoming>Flow_start_a</bpmn:incoming>
      <bpmn:outgoing>Flow_a_mid</bpmn:outgoing>
      <bpmn:outgoing>Flow_a_block</bpmn:outgoing>
      <bpmn:outgoing>Flow_a_deep</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_a_mid" name="normal" sourceRef="G_A" targetRef="Task_Assess" />
    <bpmn:serviceTask id="Task_Assess" name="Assess">
      <bpmn:incoming>Flow_a_mid</bpmn:incoming>
      <bpmn:outgoing>Flow_mid_b</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_mid_b" sourceRef="Task_Assess" targetRef="G_B" />
    <bpmn:exclusiveGateway id="G_B" name="Check">
      <bpmn:incoming>Flow_mid_b</bpmn:incoming>
      <bpmn:outgoing>Flow_b_settle</bpmn:outgoing>
      <bpmn:outgoing>Flow_b_shallow</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_b_settle" name="clean" sourceRef="G_B" targetRef="Task_Settle" />
    <bpmn:serviceTask id="Task_Settle" name="Settle">
      <bpmn:incoming>Flow_b_settle</bpmn:incoming>
      <bpmn:incoming>Flow_shallow_join</bpmn:incoming>
      <bpmn:incoming>Flow_deep_join</bpmn:incoming>
      <bpmn:outgoing>Flow_settle_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_settle_end" sourceRef="Task_Settle" targetRef="End_Blocked" />
    <bpmn:endEvent id="End_Blocked" name="Job settled">
      <bpmn:incoming>Flow_settle_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_b_shallow" name="fix" sourceRef="G_B" targetRef="Task_Approve" />
    <bpmn:serviceTask id="Task_Approve" name="Approve">
      <bpmn:incoming>Flow_b_shallow</bpmn:incoming>
      <bpmn:outgoing>Flow_shallow_join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_shallow_join" sourceRef="Task_Approve" targetRef="Task_Settle" />
    <bpmn:sequenceFlow id="Flow_a_block" name="abort" sourceRef="G_A" targetRef="Task_Log" />
    <bpmn:serviceTask id="Task_Log" name="Log">
      <bpmn:incoming>Flow_a_block</bpmn:incoming>
      <bpmn:outgoing>Flow_log_notify</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_log_notify" sourceRef="Task_Log" targetRef="Task_Notify" />
    <bpmn:serviceTask id="Task_Notify" name="Notify">
      <bpmn:incoming>Flow_log_notify</bpmn:incoming>
      <bpmn:outgoing>Flow_notify_escalate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_notify_escalate" sourceRef="Task_Notify" targetRef="Task_Escalate" />
    <bpmn:serviceTask id="Task_Escalate" name="Escalate">
      <bpmn:incoming>Flow_notify_escalate</bpmn:incoming>
      <bpmn:outgoing>Flow_escalate_abort</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_escalate_abort" sourceRef="Task_Escalate" targetRef="End_Abort" />
    <bpmn:endEvent id="End_Abort" name="Job aborted">
      <bpmn:incoming>Flow_escalate_abort</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_a_deep" name="retry" sourceRef="G_A" targetRef="Task_Retry" />
    <bpmn:serviceTask id="Task_Retry" name="Retry">
      <bpmn:incoming>Flow_a_deep</bpmn:incoming>
      <bpmn:outgoing>Flow_deep_join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_deep_join" sourceRef="Task_Retry" targetRef="Task_Settle" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
