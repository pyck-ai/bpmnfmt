<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_1ksue5u" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.22.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.4.0">
  <!--
    CANONICAL WF102 diagram — synced to the Go implementation
    (workflows/102-tour-execution/temporal/workflow.go) on 2026-06-10.

    This file replaced two stale artifacts:
      - the previous tour-execution.bpmn still showed the v3 shortage
        order (write-off BEFORE the alternatives gateway, no
        delete-original) — the exact ordering whose failure produced
        a 2026-05-27 live shortage incident;
      - tour-execution.shortage-fix.bpmn carried the corrected v3.2
        shortage branch but was never committed and lacked everything
        below.

    Synced in this revision (matching code):
      1. v3.2 shortage order (delete original FIRST — see the history
         comment at the shortage branch).
      2. ConfirmShelfEmpty guard gate between the
         shelf-empty report and the shortage branch; Cancel returns to
         the scan with zero side effects.
      3. Quantity bounds on ScanPickItem: the workflow rejects
         actualQuantity < 0 or > expected inline (re-prompt with
         ctx.errors). Authoritative server-side bound — the mobile
         NumberField has no ceiling.
      4. FetchTourDetails + empty-tour bypass (0 movements → complete
         immediately, no trolley/labels/delivery).
      5. ScanTrolley / ScanOrderBox wired into the flow (they were
         floating). Bind rejections (unknown trolley, trolley claimed
         by another RUNNING tour, stale box label) re-prompt inline
         via ctx.errors — retry loops not drawn per scan gate.
      6. DeliverTrolleyToPackingZone: the physical trolley repo-move
         (boxes follow as children) after the picker's DeliverToPacking
         confirmation, before BookIntoPacking.
      7. Replenishment DRAIN LOOP: one "Wait for replenishment"
         user-task gate PER queued shortfall task (its Validate only
         accepts that task's SKU), then the fresh pick movement is
         inserted and re-picked. A re-pick that shorts again queues
         another task → another gate. Deliberately unbounded
         (ops-driven), like WF100's hourly retry.
      8. No Finish gate: the workflow auto-completes after
         BookIntoPacking. The old "Instruct user to attach labels" and
         "Confirm tour finished" user tasks are gone from code and now
         from the diagram too.
      9. Compensation (not drawable as sequence flow — Temporal defers
         on a disconnected context, run on EVERY non-completed exit):
         AbortTour deletes the collection's executed=false movements
         (releasing outgoing_stock reservations) and reverts
         still-in_tour orders to fulfillable; ReleaseTrolley clears the
         trolley claim. See the standalone annotation near the start
         event.
  -->
  <bpmn:process id="Process_0vf1lkj" isExecutable="true">
    <bpmn:startEvent id="Event_05zjcyb" name="MC / Tour created">
      <bpmn:outgoing>Flow_0lxh5gu</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_0lxh5gu" sourceRef="Event_05zjcyb" targetRef="Activity_fetch_tour" />
    <bpmn:serviceTask id="Activity_fetch_tour" name="Fetch tour details (orders, movements, write-off sink)">
      <bpmn:incoming>Flow_0lxh5gu</bpmn:incoming>
      <bpmn:outgoing>Flow_fetch_to_gw</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_fetch_to_gw" sourceRef="Activity_fetch_tour" targetRef="Gateway_any_movements" />
    <bpmn:exclusiveGateway id="Gateway_any_movements" name="Any movements in tour?">
      <bpmn:incoming>Flow_fetch_to_gw</bpmn:incoming>
      <bpmn:outgoing>Flow_gw_to_print</bpmn:outgoing>
      <bpmn:outgoing>Flow_gw_empty</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_gw_empty" name="No — complete immediately" sourceRef="Gateway_any_movements" targetRef="Event_empty_tour" />
    <bpmn:endEvent id="Event_empty_tour" name="Empty tour completed">
      <bpmn:incoming>Flow_gw_empty</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_gw_to_print" name="Yes" sourceRef="Gateway_any_movements" targetRef="Activity_0t4iewd" />
    <bpmn:serviceTask id="Activity_0t4iewd" name="Print order labels">
      <bpmn:incoming>Flow_gw_to_print</bpmn:incoming>
      <bpmn:outgoing>Flow_print_to_trolley</bpmn:outgoing>
    </bpmn:serviceTask>
    <!--
      Tour-start binding gates (wired since 2026-06-10; they existed as
      floating tasks before):
        1. ScanTrolley — picker scans the dynamic acme-trolley repo they
           grabbed from the parking area. BindTrolley rejects unknown
           names and trolleys claimed by another RUNNING tour (stale
           claims of terminal tours are reclaimed); rejections re-prompt
           inline via ctx.errors.
        2. ScanOrderBox — once per order in the tour (print order): the
           picker sticks the order label on an empty box and scans it.
           BindOrderBox re-parents the box repo under the trolley and
           rejects order numbers that don't belong to this tour.
    -->
    <bpmn:sequenceFlow id="Flow_print_to_trolley" sourceRef="Activity_0t4iewd" targetRef="Activity_scan_trolley" />
    <bpmn:userTask id="Activity_scan_trolley" name="Scan trolley">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_print_to_trolley</bpmn:incoming>
      <bpmn:outgoing>Flow_trolley_to_orderbox</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_trolley_to_orderbox" sourceRef="Activity_scan_trolley" targetRef="Activity_scan_order_box" />
    <bpmn:userTask id="Activity_scan_order_box" name="Scan order box (once per order)">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_trolley_to_orderbox</bpmn:incoming>
      <bpmn:outgoing>Flow_orderbox_to_src</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_orderbox_to_src" sourceRef="Activity_scan_order_box" targetRef="Activity_1b1t68m" />
    <bpmn:userTask id="Activity_1b1t68m" name="Scan source slot">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_orderbox_to_src</bpmn:incoming>
      <bpmn:incoming>Flow_0tcw3fm</bpmn:incoming>
      <bpmn:incoming>Flow_insert_to_src</bpmn:incoming>
      <bpmn:outgoing>Flow_pick_src_to_item</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_pick_src_to_item" sourceRef="Activity_1b1t68m" targetRef="Activity_pick_item" />
    <bpmn:userTask id="Activity_pick_item" name="Scan item barcode + picked count">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_pick_src_to_item</bpmn:incoming>
      <bpmn:incoming>Flow_confirmgw_no_item</bpmn:incoming>
      <bpmn:outgoing>Flow_item_to_emptygw</bpmn:outgoing>
    </bpmn:userTask>
    <!--
      ConfirmShelfEmpty guard: tapping "Shelf is empty
      for this SKU" submits {skuScanned:"", actualQuantity:0,
      shelfEmpty:true} and routes here BEFORE anything irreversible.
      Cancel returns to the scan screen with zero side effects; Confirm
      proceeds (the box scan still happens — all three pick gates always
      run — and the quantity gateway below then routes to the shortage
      branch).
    -->
    <bpmn:sequenceFlow id="Flow_item_to_emptygw" sourceRef="Activity_pick_item" targetRef="Gateway_shelf_empty" />
    <bpmn:exclusiveGateway id="Gateway_shelf_empty" name="Shelf-empty reported?">
      <bpmn:incoming>Flow_item_to_emptygw</bpmn:incoming>
      <bpmn:outgoing>Flow_emptygw_no_box</bpmn:outgoing>
      <bpmn:outgoing>Flow_emptygw_yes_confirm</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_emptygw_no_box" name="No" sourceRef="Gateway_shelf_empty" targetRef="Activity_pick_box" />
    <bpmn:sequenceFlow id="Flow_emptygw_yes_confirm" name="Yes" sourceRef="Gateway_shelf_empty" targetRef="Activity_confirm_shelf_empty" />
    <bpmn:userTask id="Activity_confirm_shelf_empty" name="Confirm: shelf empty?">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_emptygw_yes_confirm</bpmn:incoming>
      <bpmn:outgoing>Flow_confirm_to_confirmgw</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_confirm_to_confirmgw" sourceRef="Activity_confirm_shelf_empty" targetRef="Gateway_confirm_empty" />
    <bpmn:exclusiveGateway id="Gateway_confirm_empty" name="Confirmed?">
      <bpmn:incoming>Flow_confirm_to_confirmgw</bpmn:incoming>
      <bpmn:outgoing>Flow_confirmgw_yes_box</bpmn:outgoing>
      <bpmn:outgoing>Flow_confirmgw_no_item</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_confirmgw_yes_box" name="Yes" sourceRef="Gateway_confirm_empty" targetRef="Activity_pick_box" />
    <bpmn:sequenceFlow id="Flow_confirmgw_no_item" name="No — back to scan, no side effects" sourceRef="Gateway_confirm_empty" targetRef="Activity_pick_item" />
    <bpmn:userTask id="Activity_pick_box" name="Scan destination box">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_emptygw_no_box</bpmn:incoming>
      <bpmn:incoming>Flow_confirmgw_yes_box</bpmn:incoming>
      <bpmn:outgoing>Flow_1kp0pkq</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_1mr53mh" name="Picker found the expected quantity?">
      <bpmn:incoming>Flow_1kp0pkq</bpmn:incoming>
      <bpmn:outgoing>Flow_08lrpnf</bpmn:outgoing>
      <bpmn:outgoing>Flow_1yetr58</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1kp0pkq" sourceRef="Activity_pick_box" targetRef="Gateway_1mr53mh" />
    <bpmn:sequenceFlow id="Flow_0tcw3fm" name="Yes" sourceRef="Gateway_08wsh14" targetRef="Activity_1b1t68m" />
    <bpmn:exclusiveGateway id="Gateway_08wsh14" name="Any remaining positions without replenishment triggered?">
      <bpmn:incoming>Flow_08lrpnf</bpmn:incoming>
      <bpmn:incoming>Flow_08gou0k</bpmn:incoming>
      <bpmn:incoming>Flow_0rm1m90</bpmn:incoming>
      <bpmn:outgoing>Flow_0tcw3fm</bpmn:outgoing>
      <bpmn:outgoing>Flow_1a8fb2c</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_08lrpnf" name="Yes" sourceRef="Gateway_1mr53mh" targetRef="Gateway_08wsh14" />
    <bpmn:exclusiveGateway id="Gateway_02z33cs" name="Item has another known picking location?">
      <bpmn:incoming>Flow_enum_to_gw</bpmn:incoming>
      <bpmn:outgoing>Flow_00w2lja</bpmn:outgoing>
      <bpmn:outgoing>Flow_1wwhlf0</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <!--
      Shortage flow corrected order (v3.2, validated live 2026-05-27):

      History of the bug this evolved through:

        v3 (pre-fix): Reconcile shortage (write-off + delete + partial
        pick) ran FIRST, then "alt location?" gateway, then redistribute.
        By the time redistribute ran, the source's own_quantity was
        already drained. The alternative slot never received the phantom
        claim and the picker hit stock-underflow on ExecutePickMovement.

        v3.1 (2026-05-27 morning): reordered so redistribute runs BEFORE
        the write-off. Looked right on paper. Live e2e (run against
        a dev environment) revealed a deeper issue: pyck rejects ANY new movement
        from the source slot while the original pending pick movement is
        still alive. The original holds an outgoing_stock reservation
        equal to its quantity, so effective stock = 0 and pyck's
        CreateInventoryItemMovement validation fails with 'insufficient
        stock' on redistribute (and would have on the v3 write-off too —
        same wall, just a different first victim).

      v3.2 (this diagram, matches handleShortage in workflow.go): delete
      the original pending movement FIRST. That releases the source's
      outgoing_stock reservation immediately; subsequent redistribute +
      reconcile activities then see the source's true own_quantity.

      Flow:
        1. Delete original pending movement (Activity_delete_original) —
           releases outgoing_stock at the source slot so any new
           movement from that slot passes pyck's stock validation.
           Idempotent on Temporal replay.
        2. Enumerate master-data alternatives (Activity_enumerate_alternatives)
        3. Gateway: any candidate found?
           YES → Redistribute claim from failed slot → Insert new
                 pick at alternative → Reconcile partial pick at
                 failed slot (write-off only the residual that
                 redistribute couldn't move; the rest now lives at
                 the alternative slot in the ledger).
           NO  → Reconcile shortage with full write-off (the missing
                 units are truly lost from the perspective of master
                 data) → Trigger replenishment + queue ShortfallTask
                 for the post-loop drain (see the replenishment gate).
    -->
    <bpmn:sequenceFlow id="Flow_1yetr58" name="No" sourceRef="Gateway_1mr53mh" targetRef="Activity_delete_original" />
    <bpmn:serviceTask id="Activity_delete_original" name="Delete original pending movement (release reservation)">
      <bpmn:incoming>Flow_1yetr58</bpmn:incoming>
      <bpmn:outgoing>Flow_delete_to_enum</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_delete_to_enum" sourceRef="Activity_delete_original" targetRef="Activity_enumerate_alternatives" />
    <bpmn:serviceTask id="Activity_enumerate_alternatives" name="Enumerate master-data alternative locations">
      <bpmn:incoming>Flow_delete_to_enum</bpmn:incoming>
      <bpmn:outgoing>Flow_enum_to_gw</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_enum_to_gw" sourceRef="Activity_enumerate_alternatives" targetRef="Gateway_02z33cs" />
    <bpmn:sequenceFlow id="Flow_00w2lja" name="Yes" sourceRef="Gateway_02z33cs" targetRef="Activity_0bgjw4w" />
    <bpmn:serviceTask id="Activity_0bgjw4w" name="Redistribute claim from failed slot to alternative">
      <bpmn:incoming>Flow_00w2lja</bpmn:incoming>
      <bpmn:outgoing>Flow_1gv1bva</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1gv1bva" sourceRef="Activity_0bgjw4w" targetRef="Activity_0xazvfn" />
    <bpmn:serviceTask id="Activity_0xazvfn" name="Insert new pick movement at alternative slot">
      <bpmn:incoming>Flow_1gv1bva</bpmn:incoming>
      <bpmn:outgoing>Flow_xazvfn_to_partial</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_xazvfn_to_partial" sourceRef="Activity_0xazvfn" targetRef="Activity_partial_reconcile" />
    <bpmn:serviceTask id="Activity_partial_reconcile" name="Reconcile partial pick at failed slot (no write-off)">
      <bpmn:incoming>Flow_xazvfn_to_partial</bpmn:incoming>
      <bpmn:outgoing>Flow_08gou0k</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_08gou0k" sourceRef="Activity_partial_reconcile" targetRef="Gateway_08wsh14" />
    <bpmn:sequenceFlow id="Flow_1wwhlf0" name="No — requires replenishment" sourceRef="Gateway_02z33cs" targetRef="Activity_reconcile_shortage" />
    <bpmn:serviceTask id="Activity_reconcile_shortage" name="Reconcile shortage with full write-off">
      <bpmn:incoming>Flow_1wwhlf0</bpmn:incoming>
      <bpmn:outgoing>Flow_reconcile_to_replenish</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_reconcile_to_replenish" sourceRef="Activity_reconcile_shortage" targetRef="Activity_0jtm7jf" />
    <bpmn:serviceTask id="Activity_0jtm7jf" name="Trigger replenishment in host system and queue shortfall task">
      <bpmn:incoming>Flow_reconcile_to_replenish</bpmn:incoming>
      <bpmn:outgoing>Flow_0rm1m90</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_0rm1m90" sourceRef="Activity_0jtm7jf" targetRef="Gateway_08wsh14" />
    <bpmn:exclusiveGateway id="Gateway_02fo3jw" name="Do we have complete Orders?">
      <bpmn:incoming>Flow_1a8fb2c</bpmn:incoming>
      <bpmn:outgoing>Flow_1rt90d1</bpmn:outgoing>
      <bpmn:outgoing>Flow_1kohpbo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1a8fb2c" sourceRef="Gateway_08wsh14" targetRef="Gateway_02fo3jw" />
    <bpmn:sequenceFlow id="Flow_1rt90d1" name="Yes" sourceRef="Gateway_02fo3jw" targetRef="Activity_1jpf51l" />
    <bpmn:userTask id="Activity_1jpf51l" name="Bring XYZ Order to Packing Zone">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1rt90d1</bpmn:incoming>
      <bpmn:outgoing>Flow_0urf8fg</bpmn:outgoing>
    </bpmn:userTask>
    <!--
      Replenishment drain loop (matches workflow.go step 6): the gate
      below is awaited ONCE PER queued ShortfallTask — its widget shows
      that task's SKU/slot/quantity and its Validate only accepts that
      SKU. After each confirmation the fresh pick movement is inserted
      at the refilled slot and the flow loops back into the pick loop.
      A re-pick that shorts again queues another task → another pass
      through this gate. (The earlier implementation awaited once for
      ALL tasks and dropped tasks queued during re-picks.)
    -->
    <bpmn:sequenceFlow id="Flow_1kohpbo" name="No" sourceRef="Gateway_02fo3jw" targetRef="Activity_0e37vw3" />
    <bpmn:userTask id="Activity_0e37vw3" name="Wait for replenishment to complete (one gate per shortfall task)">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1kohpbo</bpmn:incoming>
      <bpmn:outgoing>Flow_replenish_to_insert</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_replenish_to_insert" sourceRef="Activity_0e37vw3" targetRef="Activity_insert_shortfall" />
    <bpmn:serviceTask id="Activity_insert_shortfall" name="Insert fresh pick movement at refilled slot">
      <bpmn:incoming>Flow_replenish_to_insert</bpmn:incoming>
      <bpmn:outgoing>Flow_insert_to_src</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_insert_to_src" sourceRef="Activity_insert_shortfall" targetRef="Activity_1b1t68m" />
    <bpmn:sequenceFlow id="Flow_0urf8fg" sourceRef="Activity_1jpf51l" targetRef="Activity_deliver_trolley" />
    <bpmn:serviceTask id="Activity_deliver_trolley" name="Move trolley repo into PACKING-ZONE (boxes follow as children)">
      <bpmn:incoming>Flow_0urf8fg</bpmn:incoming>
      <bpmn:outgoing>Flow_trolley_to_book</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_trolley_to_book" sourceRef="Activity_deliver_trolley" targetRef="Activity_05s8j5b" />
    <bpmn:serviceTask id="Activity_05s8j5b" name="Book Items into Packing Zone + orders → picked">
      <bpmn:incoming>Flow_trolley_to_book</bpmn:incoming>
      <bpmn:outgoing>Flow_book_to_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_book_to_end" sourceRef="Activity_05s8j5b" targetRef="Event_1jvr8va" />
    <bpmn:endEvent id="Event_1jvr8va" name="Tour completed (auto — no Finish gate)">
      <bpmn:incoming>Flow_book_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:textAnnotation id="TextAnnotation_1cv23z6">
      <bpmn:text>Printer: zone label printer
Open questions: Print server setup?
Direct access from mobile device?</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1jdipc6" associationDirection="None" sourceRef="Activity_0t4iewd" targetRef="TextAnnotation_1cv23z6" />
    <bpmn:textAnnotation id="TextAnnotation_0ys7j7p">
      <bpmn:text>We need to ensure that they are able to pick "whatever they can get" from that repo</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_091n2v1" associationDirection="None" sourceRef="Flow_1yetr58" targetRef="TextAnnotation_0ys7j7p" />
    <bpmn:textAnnotation id="TextAnnotation_abort_compensation">
      <bpmn:text>Compensation (Temporal defers on a disconnected context — runs on EVERY non-completed exit: cancel, terminate, failure; not drawable as sequence flow):
1. AbortTour — deletes the collection's executed=false movements (releases the slots' outgoing_stock reservations) and reverts still-in_tour orders to "fulfillable" so the next WF101 run re-tours them. Idempotent; bounded retries.
2. ReleaseTrolley — clears this tour's trolley claim.
Executed picks stay executed (physical reality); their boxes remain on the trolley for manual return-to-shelf.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_abort_compensation" associationDirection="None" sourceRef="Event_05zjcyb" targetRef="TextAnnotation_abort_compensation" />
    <bpmn:textAnnotation id="TextAnnotation_overpick_guard">
      <bpmn:text>Quantity bounds (server-authoritative): the workflow rejects actualQuantity &lt; 0 or &gt; expected inline and re-prompts with the violation in ctx.errors. Web widget also blocks client-side; the mobile NumberField has no ceiling, so this guard is the real one.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_overpick_guard" associationDirection="None" sourceRef="Activity_pick_item" targetRef="TextAnnotation_overpick_guard" />
    <!--
      ID: annotations below link each user task to its widget name (the
      `widget <Name> =` declaration in flutter/index.rfwtxt and the
      matching React component under web/). The workflowgen stitcher
      reads widget declarations from the rfwtxt; these annotations
      document the mapping for humans. The legacy AttachLabels and
      Finish user tasks were removed from the FLOW in the 2026-06-10
      sync (they had already been removed from code and widgets in the
      trolley/box-binding rewrite).
    -->
    <bpmn:textAnnotation id="TextAnnotation_widget_scan_trolley">
      <bpmn:text>ID: ScanTrolley</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_widget_scan_trolley" associationDirection="None" sourceRef="Activity_scan_trolley" targetRef="TextAnnotation_widget_scan_trolley" />
    <bpmn:textAnnotation id="TextAnnotation_widget_scan_order_box">
      <bpmn:text>ID: ScanOrderBox</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_widget_scan_order_box" associationDirection="None" sourceRef="Activity_scan_order_box" targetRef="TextAnnotation_widget_scan_order_box" />
    <bpmn:textAnnotation id="TextAnnotation_widget_scan_pick_source">
