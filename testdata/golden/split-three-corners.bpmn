      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_LongCollect_di" bpmnElement="Task_LongCollect">
        <dc:Bounds x="518" y="310" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_LongAssess_di" bpmnElement="Task_LongAssess">
        <dc:Bounds x="678" y="310" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_LongRule_di" bpmnElement="Task_LongRule">
        <dc:Bounds x="838" y="310" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_LongArchive_di" bpmnElement="Task_LongArchive">
        <dc:Bounds x="998" y="310" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Disputed_di" bpmnElement="End_Disputed">
