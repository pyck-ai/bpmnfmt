    <bpmn:textAnnotation id="TextAnnotation_0x6rv4s">
      <bpmn:text>Assumption for sortation (see the warehouse floor plan): picking tours start close to the elevator and end at the end of aisle 13/14, where order containers are placed on a conveyor belt</bpmn:text>
    </bpmn:textAnnotation>
